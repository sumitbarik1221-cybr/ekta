# Copy to .env (never commit .env). Server keys stay server-side.
# ---- Server-side AI keys (never prefix these with VITE_) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173
# Server-only Supabase Auth lookup key (never add the VITE_ prefix or expose in the browser)
SUPABASE_SECRET_KEY=

# ---- Browser settings ----
VITE_GOOGLE_MAPS_API_KEY=
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
